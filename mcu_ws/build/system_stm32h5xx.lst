 281:Core/Src/system_stm32h5xx.c **** /**
 282:Core/Src/system_stm32h5xx.c ****   * @brief  Update SystemCoreClock variable according to Clock Register Values.
 283:Core/Src/system_stm32h5xx.c ****   *         The SystemCoreClock variable contains the core clock (HCLK), it can
 284:Core/Src/system_stm32h5xx.c ****   *         be used by the user application to setup the SysTick timer or configure
 285:Core/Src/system_stm32h5xx.c ****   *         other parameters.
 286:Core/Src/system_stm32h5xx.c ****   *
 287:Core/Src/system_stm32h5xx.c ****   * @note   Each time the core clock (HCLK) changes, this function must be called
 288:Core/Src/system_stm32h5xx.c ****   *         to update SystemCoreClock variable value. Otherwise, any configuration
 289:Core/Src/system_stm32h5xx.c ****   *         based on this variable will be incorrect.
 290:Core/Src/system_stm32h5xx.c ****   *
 291:Core/Src/system_stm32h5xx.c ****   * @note   - The system frequency computed by this function is not the real
 292:Core/Src/system_stm32h5xx.c ****   *           frequency in the chip. It is calculated based on the predefined
 293:Core/Src/system_stm32h5xx.c ****   *           constant and the selected clock source:
 294:Core/Src/system_stm32h5xx.c ****   *
 295:Core/Src/system_stm32h5xx.c ****   *           - If SYSCLK source is CSI, SystemCoreClock will contain the CSI_VALUE(*)
 296:Core/Src/system_stm32h5xx.c ****   *
 297:Core/Src/system_stm32h5xx.c ****   *           - If SYSCLK source is HSI, SystemCoreClock will contain the HSI_VALUE(**)
 298:Core/Src/system_stm32h5xx.c ****   *
 299:Core/Src/system_stm32h5xx.c ****   *           - If SYSCLK source is HSE, SystemCoreClock will contain the HSE_VALUE(***)
 300:Core/Src/system_stm32h5xx.c ****   *
 301:Core/Src/system_stm32h5xx.c ****   *           - If SYSCLK source is PLL, SystemCoreClock will contain the HSE_VALUE(***)
 302:Core/Src/system_stm32h5xx.c ****   *             or HSI_VALUE(**) or CSI_VALUE(*) multiplied/divided by the PLL factors.
 303:Core/Src/system_stm32h5xx.c ****   *
 304:Core/Src/system_stm32h5xx.c ****   *         (*) CSI_VALUE is a constant defined in stm32h5xx_hal.h file (default value
 305:Core/Src/system_stm32h5xx.c ****   *             4 MHz) but the real value may vary depending on the variations
 306:Core/Src/system_stm32h5xx.c ****   *             in voltage and temperature.
 307:Core/Src/system_stm32h5xx.c ****   *
 308:Core/Src/system_stm32h5xx.c ****   *         (**) HSI_VALUE is a constant defined in stm32h5xx_hal.h file (default value
 309:Core/Src/system_stm32h5xx.c ****   *              64 MHz) but the real value may vary depending on the variations
 310:Core/Src/system_stm32h5xx.c ****   *              in voltage and temperature.
 311:Core/Src/system_stm32h5xx.c ****   *
 312:Core/Src/system_stm32h5xx.c ****   *         (***) HSE_VALUE is a constant defined in stm32h5xx_hal.h file (default value
 313:Core/Src/system_stm32h5xx.c ****   *              25 MHz), user has to ensure that HSE_VALUE is same as the real
 314:Core/Src/system_stm32h5xx.c ****   *              frequency of the crystal used. Otherwise, this function may
 315:Core/Src/system_stm32h5xx.c ****   *              have wrong result.
 316:Core/Src/system_stm32h5xx.c ****   *
 317:Core/Src/system_stm32h5xx.c ****   *         - The result of this function could be not correct when using fractional
 318:Core/Src/system_stm32h5xx.c ****   *           value for HSE crystal.
 319:Core/Src/system_stm32h5xx.c ****   *
 320:Core/Src/system_stm32h5xx.c ****   * @param  None
 321:Core/Src/system_stm32h5xx.c ****   * @retval None
 322:Core/Src/system_stm32h5xx.c ****   */
 323:Core/Src/system_stm32h5xx.c **** void SystemCoreClockUpdate(void)
