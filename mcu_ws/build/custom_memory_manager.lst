 277:Core/Src/custom_memory_manager.c **** size_t getBlockSize( void *pv )
 278:Core/Src/custom_memory_manager.c **** {
 279:Core/Src/custom_memory_manager.c **** 
 280:Core/Src/custom_memory_manager.c **** 	uint8_t *puc = ( uint8_t * ) pv;
 281:Core/Src/custom_memory_manager.c **** 	BlockLink_t *pxLink;
 282:Core/Src/custom_memory_manager.c **** 
 283:Core/Src/custom_memory_manager.c **** 	puc -= xHeapStructSize;
 284:Core/Src/custom_memory_manager.c **** 	pxLink = ( void * ) puc;
 285:Core/Src/custom_memory_manager.c **** 
 286:Core/Src/custom_memory_manager.c **** 	size_t count = pxLink->xBlockSize & ~xBlockAllocatedBit;
 287:Core/Src/custom_memory_manager.c **** 
 288:Core/Src/custom_memory_manager.c **** 	return count;
 289:Core/Src/custom_memory_manager.c **** }
