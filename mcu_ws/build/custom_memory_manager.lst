  32:Core/Src/custom_memory_manager.c **** /* Define the linked list structure.  This is used to link free blocks in order
  33:Core/Src/custom_memory_manager.c **** of their memory address. */
  34:Core/Src/custom_memory_manager.c **** typedef struct A_BLOCK_LINK
  35:Core/Src/custom_memory_manager.c **** {
  36:Core/Src/custom_memory_manager.c **** 	struct A_BLOCK_LINK *pxNextFreeBlock;	/*<< The next free block in the list. */
  37:Core/Src/custom_memory_manager.c **** 	size_t xBlockSize;						/*<< The size of the free block. */
  38:Core/Src/custom_memory_manager.c **** } BlockLink_t;
  39:Core/Src/custom_memory_manager.c **** 
  40:Core/Src/custom_memory_manager.c **** /*-----------------------------------------------------------*/
  41:Core/Src/custom_memory_manager.c **** 
  42:Core/Src/custom_memory_manager.c **** /*
  43:Core/Src/custom_memory_manager.c ****  * Inserts a block of memory that is being freed into the correct position in
  44:Core/Src/custom_memory_manager.c ****  * the list of free memory blocks.  The block being freed will be merged with
  45:Core/Src/custom_memory_manager.c ****  * the block in front it and/or the block behind it if the memory blocks are
  46:Core/Src/custom_memory_manager.c ****  * adjacent to each other.
  47:Core/Src/custom_memory_manager.c ****  */
  48:Core/Src/custom_memory_manager.c **** static void prvInsertBlockIntoFreeList( BlockLink_t *pxBlockToInsert );
  49:Core/Src/custom_memory_manager.c **** 
  50:Core/Src/custom_memory_manager.c **** /*
  51:Core/Src/custom_memory_manager.c ****  * Called automatically to setup the required heap structures the first time
  52:Core/Src/custom_memory_manager.c ****  * pvPortMallocMicroROS() is called.
  53:Core/Src/custom_memory_manager.c ****  */
  54:Core/Src/custom_memory_manager.c **** static void prvHeapInit( void );
  55:Core/Src/custom_memory_manager.c **** 
  56:Core/Src/custom_memory_manager.c **** /*-----------------------------------------------------------*/
  57:Core/Src/custom_memory_manager.c **** 
  58:Core/Src/custom_memory_manager.c **** /* The size of the structure placed at the beginning of each allocated memory
  59:Core/Src/custom_memory_manager.c **** block must by correctly byte aligned. */
  60:Core/Src/custom_memory_manager.c **** static const size_t xHeapStructSize	= ( sizeof( BlockLink_t ) + ( ( size_t ) ( portBYTE_ALIGNMENT -
  61:Core/Src/custom_memory_manager.c **** 
  62:Core/Src/custom_memory_manager.c **** /* Create a couple of list links to mark the start and end of the list. */
  63:Core/Src/custom_memory_manager.c **** static BlockLink_t xStart, *pxEnd = NULL;
  64:Core/Src/custom_memory_manager.c **** 
  65:Core/Src/custom_memory_manager.c **** /* Keeps track of the number of free bytes remaining, but says nothing about
  66:Core/Src/custom_memory_manager.c **** fragmentation. */
  67:Core/Src/custom_memory_manager.c **** static size_t xFreeBytesRemaining = 0U;
  68:Core/Src/custom_memory_manager.c **** static size_t xMinimumEverFreeBytesRemaining = 0U;
  69:Core/Src/custom_memory_manager.c **** 
  70:Core/Src/custom_memory_manager.c **** /* Gets set to the top bit of an size_t type.  When this bit in the xBlockSize
  71:Core/Src/custom_memory_manager.c **** member of an BlockLink_t structure is set then the block belongs to the
  72:Core/Src/custom_memory_manager.c **** application.  When the bit is free the block is still part of the free heap
  73:Core/Src/custom_memory_manager.c **** space. */
  74:Core/Src/custom_memory_manager.c **** static size_t xBlockAllocatedBit = 0;
  75:Core/Src/custom_memory_manager.c **** 
  76:Core/Src/custom_memory_manager.c **** /*-----------------------------------------------------------*/
  77:Core/Src/custom_memory_manager.c **** 
  78:Core/Src/custom_memory_manager.c **** void *pvPortMallocMicroROS( size_t xWantedSize )
  79:Core/Src/custom_memory_manager.c **** {
  80:Core/Src/custom_memory_manager.c **** BlockLink_t *pxBlock, *pxPreviousBlock, *pxNewBlockLink;
  81:Core/Src/custom_memory_manager.c **** void *pvReturn = NULL;
  82:Core/Src/custom_memory_manager.c **** 
  83:Core/Src/custom_memory_manager.c **** 	vTaskSuspendAll();
  84:Core/Src/custom_memory_manager.c **** 	{
  85:Core/Src/custom_memory_manager.c **** 		/* If this is the first call to malloc then the heap will require
  86:Core/Src/custom_memory_manager.c **** 		initialisation to setup the list of free blocks. */
  87:Core/Src/custom_memory_manager.c **** 		if( pxEnd == NULL )
