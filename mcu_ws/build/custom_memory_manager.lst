  88:Core/Src/custom_memory_manager.c **** 		{
  89:Core/Src/custom_memory_manager.c **** 			prvHeapInit();
  90:Core/Src/custom_memory_manager.c **** 		}
  91:Core/Src/custom_memory_manager.c **** 		else
  92:Core/Src/custom_memory_manager.c **** 		{
  93:Core/Src/custom_memory_manager.c **** 			mtCOVERAGE_TEST_MARKER();
  94:Core/Src/custom_memory_manager.c **** 		}
  95:Core/Src/custom_memory_manager.c **** 
  96:Core/Src/custom_memory_manager.c **** 		/* Check the requested block size is not so large that the top bit is
  97:Core/Src/custom_memory_manager.c **** 		set.  The top bit of the block size member of the BlockLink_t structure
  98:Core/Src/custom_memory_manager.c **** 		is used to determine who owns the block - the application or the
  99:Core/Src/custom_memory_manager.c **** 		kernel, so it must be free. */
 100:Core/Src/custom_memory_manager.c **** 		if( ( xWantedSize & xBlockAllocatedBit ) == 0 )
 101:Core/Src/custom_memory_manager.c **** 		{
 102:Core/Src/custom_memory_manager.c **** 			/* The wanted size is increased so it can contain a BlockLink_t
 103:Core/Src/custom_memory_manager.c **** 			structure in addition to the requested amount of bytes. */
 104:Core/Src/custom_memory_manager.c **** 			if( xWantedSize > 0 )
 105:Core/Src/custom_memory_manager.c **** 			{
 106:Core/Src/custom_memory_manager.c **** 				xWantedSize += xHeapStructSize;
 107:Core/Src/custom_memory_manager.c **** 
 108:Core/Src/custom_memory_manager.c **** 				/* Ensure that blocks are always aligned to the required number
 109:Core/Src/custom_memory_manager.c **** 				of bytes. */
 110:Core/Src/custom_memory_manager.c **** 				if( ( xWantedSize & portBYTE_ALIGNMENT_MASK ) != 0x00 )
 111:Core/Src/custom_memory_manager.c **** 				{
 112:Core/Src/custom_memory_manager.c **** 					/* Byte alignment required. */
 113:Core/Src/custom_memory_manager.c **** 					xWantedSize += ( portBYTE_ALIGNMENT - ( xWantedSize & portBYTE_ALIGNMENT_MASK ) );
 114:Core/Src/custom_memory_manager.c **** 					configASSERT( ( xWantedSize & portBYTE_ALIGNMENT_MASK ) == 0 );
 115:Core/Src/custom_memory_manager.c **** 				}
 116:Core/Src/custom_memory_manager.c **** 				else
 117:Core/Src/custom_memory_manager.c **** 				{
 118:Core/Src/custom_memory_manager.c **** 					mtCOVERAGE_TEST_MARKER();
 119:Core/Src/custom_memory_manager.c **** 				}
 120:Core/Src/custom_memory_manager.c **** 			}
 121:Core/Src/custom_memory_manager.c **** 			else
 122:Core/Src/custom_memory_manager.c **** 			{
 123:Core/Src/custom_memory_manager.c **** 				mtCOVERAGE_TEST_MARKER();
 124:Core/Src/custom_memory_manager.c **** 			}
 125:Core/Src/custom_memory_manager.c **** 
 126:Core/Src/custom_memory_manager.c **** 			if( ( xWantedSize > 0 ) && ( xWantedSize <= xFreeBytesRemaining ) )
 127:Core/Src/custom_memory_manager.c **** 			{
 128:Core/Src/custom_memory_manager.c **** 				/* Traverse the list from the start	(lowest address) block until
 129:Core/Src/custom_memory_manager.c **** 				one	of adequate size is found. */
 130:Core/Src/custom_memory_manager.c **** 				pxPreviousBlock = &xStart;
 131:Core/Src/custom_memory_manager.c **** 				pxBlock = xStart.pxNextFreeBlock;
 132:Core/Src/custom_memory_manager.c **** 				while( ( pxBlock->xBlockSize < xWantedSize ) && ( pxBlock->pxNextFreeBlock != NULL ) )
 133:Core/Src/custom_memory_manager.c **** 				{
 134:Core/Src/custom_memory_manager.c **** 					pxPreviousBlock = pxBlock;
 135:Core/Src/custom_memory_manager.c **** 					pxBlock = pxBlock->pxNextFreeBlock;
 136:Core/Src/custom_memory_manager.c **** 				}
 137:Core/Src/custom_memory_manager.c **** 
 138:Core/Src/custom_memory_manager.c **** 				/* If the end marker was reached then a block of adequate size
 139:Core/Src/custom_memory_manager.c **** 				was	not found. */
 140:Core/Src/custom_memory_manager.c **** 				if( pxBlock != pxEnd )
 141:Core/Src/custom_memory_manager.c **** 				{
 142:Core/Src/custom_memory_manager.c **** 					/* Return the memory space pointed to - jumping over the
 143:Core/Src/custom_memory_manager.c **** 					BlockLink_t structure at its start. */
 144:Core/Src/custom_memory_manager.c **** 					pvReturn = ( void * ) ( ( ( uint8_t * ) pxPreviousBlock->pxNextFreeBlock ) + xHeapStructSize )
ARM GAS  /tmp/ccgeRYqu.s 			page 4


 145:Core/Src/custom_memory_manager.c **** 
 146:Core/Src/custom_memory_manager.c **** 					/* This block is being returned for use so must be taken out
 147:Core/Src/custom_memory_manager.c **** 					of the list of free blocks. */
 148:Core/Src/custom_memory_manager.c **** 					pxPreviousBlock->pxNextFreeBlock = pxBlock->pxNextFreeBlock;
 149:Core/Src/custom_memory_manager.c **** 
 150:Core/Src/custom_memory_manager.c **** 					/* If the block is larger than required it can be split into
 151:Core/Src/custom_memory_manager.c **** 					two. */
 152:Core/Src/custom_memory_manager.c **** 					if( ( pxBlock->xBlockSize - xWantedSize ) > heapMINIMUM_BLOCK_SIZE )
 153:Core/Src/custom_memory_manager.c **** 					{
 154:Core/Src/custom_memory_manager.c **** 						/* This block is to be split into two.  Create a new
 155:Core/Src/custom_memory_manager.c **** 						block following the number of bytes requested. The void
 156:Core/Src/custom_memory_manager.c **** 						cast is used to prevent byte alignment warnings from the
 157:Core/Src/custom_memory_manager.c **** 						compiler. */
 158:Core/Src/custom_memory_manager.c **** 						pxNewBlockLink = ( void * ) ( ( ( uint8_t * ) pxBlock ) + xWantedSize );
 159:Core/Src/custom_memory_manager.c **** 						configASSERT( ( ( ( size_t ) pxNewBlockLink ) & portBYTE_ALIGNMENT_MASK ) == 0 );
 160:Core/Src/custom_memory_manager.c **** 
 161:Core/Src/custom_memory_manager.c **** 						/* Calculate the sizes of two blocks split from the
 162:Core/Src/custom_memory_manager.c **** 						single block. */
 163:Core/Src/custom_memory_manager.c **** 						pxNewBlockLink->xBlockSize = pxBlock->xBlockSize - xWantedSize;
 164:Core/Src/custom_memory_manager.c **** 						pxBlock->xBlockSize = xWantedSize;
 165:Core/Src/custom_memory_manager.c **** 
 166:Core/Src/custom_memory_manager.c **** 						/* Insert the new block into the list of free blocks. */
 167:Core/Src/custom_memory_manager.c **** 						prvInsertBlockIntoFreeList( pxNewBlockLink );
 168:Core/Src/custom_memory_manager.c **** 					}
 169:Core/Src/custom_memory_manager.c **** 					else
 170:Core/Src/custom_memory_manager.c **** 					{
 171:Core/Src/custom_memory_manager.c **** 						mtCOVERAGE_TEST_MARKER();
 172:Core/Src/custom_memory_manager.c **** 					}
 173:Core/Src/custom_memory_manager.c **** 
 174:Core/Src/custom_memory_manager.c **** 					xFreeBytesRemaining -= pxBlock->xBlockSize;
 175:Core/Src/custom_memory_manager.c **** 
 176:Core/Src/custom_memory_manager.c **** 					if( xFreeBytesRemaining < xMinimumEverFreeBytesRemaining )
 177:Core/Src/custom_memory_manager.c **** 					{
 178:Core/Src/custom_memory_manager.c **** 						xMinimumEverFreeBytesRemaining = xFreeBytesRemaining;
 179:Core/Src/custom_memory_manager.c **** 					}
 180:Core/Src/custom_memory_manager.c **** 					else
 181:Core/Src/custom_memory_manager.c **** 					{
 182:Core/Src/custom_memory_manager.c **** 						mtCOVERAGE_TEST_MARKER();
 183:Core/Src/custom_memory_manager.c **** 					}
 184:Core/Src/custom_memory_manager.c **** 
 185:Core/Src/custom_memory_manager.c **** 					/* The block is being returned - it is allocated and owned
 186:Core/Src/custom_memory_manager.c **** 					by the application and has no "next" block. */
 187:Core/Src/custom_memory_manager.c **** 					pxBlock->xBlockSize |= xBlockAllocatedBit;
 188:Core/Src/custom_memory_manager.c **** 					pxBlock->pxNextFreeBlock = NULL;
 189:Core/Src/custom_memory_manager.c **** 				}
 190:Core/Src/custom_memory_manager.c **** 				else
 191:Core/Src/custom_memory_manager.c **** 				{
 192:Core/Src/custom_memory_manager.c **** 					mtCOVERAGE_TEST_MARKER();
 193:Core/Src/custom_memory_manager.c **** 				}
 194:Core/Src/custom_memory_manager.c **** 			}
 195:Core/Src/custom_memory_manager.c **** 			else
 196:Core/Src/custom_memory_manager.c **** 			{
 197:Core/Src/custom_memory_manager.c **** 				mtCOVERAGE_TEST_MARKER();
 198:Core/Src/custom_memory_manager.c **** 			}
 199:Core/Src/custom_memory_manager.c **** 		}
 200:Core/Src/custom_memory_manager.c **** 		else
 201:Core/Src/custom_memory_manager.c **** 		{
ARM GAS  /tmp/ccgeRYqu.s 			page 5


 202:Core/Src/custom_memory_manager.c **** 			mtCOVERAGE_TEST_MARKER();
 203:Core/Src/custom_memory_manager.c **** 		}
 204:Core/Src/custom_memory_manager.c **** 
 205:Core/Src/custom_memory_manager.c **** 		traceMALLOC( pvReturn, xWantedSize );
 206:Core/Src/custom_memory_manager.c **** 	}
 207:Core/Src/custom_memory_manager.c **** 	( void ) xTaskResumeAll();
 208:Core/Src/custom_memory_manager.c **** 
