 291:Core/Src/custom_memory_manager.c **** 
 292:Core/Src/custom_memory_manager.c **** void *pvPortReallocMicroROS( void *pv, size_t xWantedSize )
 293:Core/Src/custom_memory_manager.c **** {
 294:Core/Src/custom_memory_manager.c **** 	vTaskSuspendAll();
 295:Core/Src/custom_memory_manager.c **** 
 296:Core/Src/custom_memory_manager.c **** 	void * newmem = pvPortMallocMicroROS(xWantedSize);
 297:Core/Src/custom_memory_manager.c **** 	if (newmem != NULL && pv != NULL)
