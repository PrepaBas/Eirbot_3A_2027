   1:Core/Src/custom_memory_manager.c **** /*
   2:Core/Src/custom_memory_manager.c ****  * A custom implementation of pvPortMallocMicroROS() and vPortFreeMicroROS() with realloc and
   3:Core/Src/custom_memory_manager.c ****  * calloc features based on FreeRTOS heap4.c.
   4:Core/Src/custom_memory_manager.c ****  */
   5:Core/Src/custom_memory_manager.c ****  
   6:Core/Src/custom_memory_manager.c **** #include <stdlib.h>
   7:Core/Src/custom_memory_manager.c **** #include <string.h>
   8:Core/Src/custom_memory_manager.c **** 
   9:Core/Src/custom_memory_manager.c **** /* Defining MPU_WRAPPERS_INCLUDED_FROM_API_FILE prevents task.h from redefining
  10:Core/Src/custom_memory_manager.c **** all the API functions to use the MPU wrappers.  That should only be done when
  11:Core/Src/custom_memory_manager.c **** task.h is included from an application file. */
  12:Core/Src/custom_memory_manager.c **** #define MPU_WRAPPERS_INCLUDED_FROM_API_FILE
  13:Core/Src/custom_memory_manager.c **** 
  14:Core/Src/custom_memory_manager.c **** #include "FreeRTOS.h"
  15:Core/Src/custom_memory_manager.c **** #include "task.h"
  16:Core/Src/custom_memory_manager.c **** 
  17:Core/Src/custom_memory_manager.c **** #undef MPU_WRAPPERS_INCLUDED_FROM_API_FILE
  18:Core/Src/custom_memory_manager.c **** 
  19:Core/Src/custom_memory_manager.c **** #if( configSUPPORT_DYNAMIC_ALLOCATION == 0 )
  20:Core/Src/custom_memory_manager.c **** 	#error This file must not be used if configSUPPORT_DYNAMIC_ALLOCATION is 0
  21:Core/Src/custom_memory_manager.c **** #endif
  22:Core/Src/custom_memory_manager.c **** 
  23:Core/Src/custom_memory_manager.c **** /* Block sizes must not get too small. */
  24:Core/Src/custom_memory_manager.c **** #define heapMINIMUM_BLOCK_SIZE	( ( size_t ) ( xHeapStructSize << 1 ) )
  25:Core/Src/custom_memory_manager.c **** 
  26:Core/Src/custom_memory_manager.c **** /* Assumes 8bit bytes! */
  27:Core/Src/custom_memory_manager.c **** #define heapBITS_PER_BYTE		( ( size_t ) 8 )
  28:Core/Src/custom_memory_manager.c **** 
