 228:Core/Src/custom_memory_manager.c **** void vPortFreeMicroROS( void *pv )
 229:Core/Src/custom_memory_manager.c **** {
 230:Core/Src/custom_memory_manager.c **** uint8_t *puc = ( uint8_t * ) pv;
 231:Core/Src/custom_memory_manager.c **** BlockLink_t *pxLink;
 232:Core/Src/custom_memory_manager.c **** 
 233:Core/Src/custom_memory_manager.c **** 	if( pv != NULL )
 234:Core/Src/custom_memory_manager.c **** 	{
 235:Core/Src/custom_memory_manager.c **** 		/* The memory being freed will have an BlockLink_t structure immediately
 236:Core/Src/custom_memory_manager.c **** 		before it. */
 237:Core/Src/custom_memory_manager.c **** 		puc -= xHeapStructSize;
 238:Core/Src/custom_memory_manager.c **** 
 239:Core/Src/custom_memory_manager.c **** 		/* This casting is to keep the compiler from issuing warnings. */
 240:Core/Src/custom_memory_manager.c **** 		pxLink = ( void * ) puc;
 241:Core/Src/custom_memory_manager.c **** 
 242:Core/Src/custom_memory_manager.c **** 		/* Check the block is actually allocated. */
 243:Core/Src/custom_memory_manager.c **** 		configASSERT( ( pxLink->xBlockSize & xBlockAllocatedBit ) != 0 );
 244:Core/Src/custom_memory_manager.c **** 		configASSERT( pxLink->pxNextFreeBlock == NULL );
 245:Core/Src/custom_memory_manager.c **** 
 246:Core/Src/custom_memory_manager.c **** 		if( ( pxLink->xBlockSize & xBlockAllocatedBit ) != 0 )
 247:Core/Src/custom_memory_manager.c **** 		{
 248:Core/Src/custom_memory_manager.c **** 			if( pxLink->pxNextFreeBlock == NULL )
 249:Core/Src/custom_memory_manager.c **** 			{
 250:Core/Src/custom_memory_manager.c **** 				/* The block is being returned to the heap - it is no longer
 251:Core/Src/custom_memory_manager.c **** 				allocated. */
 252:Core/Src/custom_memory_manager.c **** 				pxLink->xBlockSize &= ~xBlockAllocatedBit;
 253:Core/Src/custom_memory_manager.c **** 
 254:Core/Src/custom_memory_manager.c **** 				vTaskSuspendAll();
 255:Core/Src/custom_memory_manager.c **** 				{
 256:Core/Src/custom_memory_manager.c **** 					/* Add this block to the list of free blocks. */
 257:Core/Src/custom_memory_manager.c **** 					xFreeBytesRemaining += pxLink->xBlockSize;
 258:Core/Src/custom_memory_manager.c **** 					traceFREE( pv, pxLink->xBlockSize );
ARM GAS  /tmp/ccgeRYqu.s 			page 6


 259:Core/Src/custom_memory_manager.c **** 					prvInsertBlockIntoFreeList( ( ( BlockLink_t * ) pxLink ) );
 260:Core/Src/custom_memory_manager.c **** 				}
 261:Core/Src/custom_memory_manager.c **** 				( void ) xTaskResumeAll();
 262:Core/Src/custom_memory_manager.c **** 			}
 263:Core/Src/custom_memory_manager.c **** 			else
 264:Core/Src/custom_memory_manager.c **** 			{
 265:Core/Src/custom_memory_manager.c **** 				mtCOVERAGE_TEST_MARKER();
 266:Core/Src/custom_memory_manager.c **** 			}
 267:Core/Src/custom_memory_manager.c **** 		}
 268:Core/Src/custom_memory_manager.c **** 		else
 269:Core/Src/custom_memory_manager.c **** 		{
 270:Core/Src/custom_memory_manager.c **** 			mtCOVERAGE_TEST_MARKER();
 271:Core/Src/custom_memory_manager.c **** 		}
 272:Core/Src/custom_memory_manager.c **** 	}
 273:Core/Src/custom_memory_manager.c **** }
