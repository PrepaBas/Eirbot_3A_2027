 529:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****  * from either an ISR or a task. */
 530:Middlewares/Third_Party/FreeRTOS/Source/tasks.c **** PRIVILEGED_DATA static volatile UBaseType_t uxSchedulerSuspended = ( UBaseType_t ) 0U;
