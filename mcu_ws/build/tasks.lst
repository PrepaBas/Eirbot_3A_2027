3836:Middlewares/Third_Party/FreeRTOS/Source/tasks.c **** 
3837:Middlewares/Third_Party/FreeRTOS/Source/tasks.c **** void vTaskSuspendAll( void )
3838:Middlewares/Third_Party/FreeRTOS/Source/tasks.c **** {
3839:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****     traceENTER_vTaskSuspendAll();
3840:Middlewares/Third_Party/FreeRTOS/Source/tasks.c **** 
3841:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****     #if ( configNUMBER_OF_CORES == 1 )
3842:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****     {
3843:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****         /* A critical section is not required as the variable is of type
3844:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          * BaseType_t. Each task maintains its own context, and a context switch
3845:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          * cannot occur if the variable is non zero. So, as long as the writing
3846:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          * from the register back into the memory is atomic, it is not a
3847:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          * problem.
3848:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          *
ARM GAS  /tmp/ccpjcmz5.s 			page 69


3849:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          * Consider the following scenario, which starts with
3850:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          * uxSchedulerSuspended at zero.
3851:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          *
3852:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          * 1. load uxSchedulerSuspended into register.
3853:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          * 2. Now a context switch causes another task to run, and the other
3854:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          *    task uses the same variable. The other task will see the variable
3855:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          *    as zero because the variable has not yet been updated by the
3856:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          *    original task. Eventually the original task runs again. **That can
3857:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          *    only happen when uxSchedulerSuspended is once again zero**. When
3858:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          *    the original task runs again, the contents of the CPU registers
3859:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          *    are restored to exactly how they were when it was switched out -
3860:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          *    therefore the value it read into the register still matches the
3861:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          *    value of the uxSchedulerSuspended variable.
3862:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          *
3863:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          * 3. increment register.
3864:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          * 4. store register into uxSchedulerSuspended. The value restored to
3865:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          *    uxSchedulerSuspended will be the correct value of 1, even though
3866:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          *    the variable was used by other tasks in the mean time.
3867:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          */
3868:Middlewares/Third_Party/FreeRTOS/Source/tasks.c **** 
3869:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****         /* portSOFTWARE_BARRIER() is only implemented for emulated/simulated ports that
3870:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****          * do not otherwise exhibit real time behaviour. */
3871:Middlewares/Third_Party/FreeRTOS/Source/tasks.c ****         portSOFTWARE_BARRIER();
3872:Middlewares/Third_Party/FreeRTOS/Source/tasks.c **** 
