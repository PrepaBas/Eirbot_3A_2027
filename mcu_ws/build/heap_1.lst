  53:Middlewares/Third_Party/FreeRTOS/Source/portable/MemMang/heap_1.c **** /* A few bytes might be lost to byte aligning the heap start address. */
  54:Middlewares/Third_Party/FreeRTOS/Source/portable/MemMang/heap_1.c **** #define configADJUSTED_HEAP_SIZE        ( configTOTAL_HEAP_SIZE - portBYTE_ALIGNMENT )
  55:Middlewares/Third_Party/FreeRTOS/Source/portable/MemMang/heap_1.c **** 
  56:Middlewares/Third_Party/FreeRTOS/Source/portable/MemMang/heap_1.c **** /* Max value that fits in a size_t type. */
  57:Middlewares/Third_Party/FreeRTOS/Source/portable/MemMang/heap_1.c **** #define heapSIZE_MAX                    ( ~( ( size_t ) 0 ) )
  58:Middlewares/Third_Party/FreeRTOS/Source/portable/MemMang/heap_1.c **** 
  59:Middlewares/Third_Party/FreeRTOS/Source/portable/MemMang/heap_1.c **** /* Check if adding a and b will result in overflow. */
  60:Middlewares/Third_Party/FreeRTOS/Source/portable/MemMang/heap_1.c **** #define heapADD_WILL_OVERFLOW( a, b )   ( ( a ) > ( heapSIZE_MAX - ( b ) ) )
