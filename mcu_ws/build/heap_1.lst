  39:Middlewares/Third_Party/FreeRTOS/Source/portable/MemMang/heap_1.c **** /* Defining MPU_WRAPPERS_INCLUDED_FROM_API_FILE prevents task.h from redefining
  40:Middlewares/Third_Party/FreeRTOS/Source/portable/MemMang/heap_1.c ****  * all the API functions to use the MPU wrappers.  That should only be done when
  41:Middlewares/Third_Party/FreeRTOS/Source/portable/MemMang/heap_1.c ****  * task.h is included from an application file. */
  42:Middlewares/Third_Party/FreeRTOS/Source/portable/MemMang/heap_1.c **** #define MPU_WRAPPERS_INCLUDED_FROM_API_FILE
  43:Middlewares/Third_Party/FreeRTOS/Source/portable/MemMang/heap_1.c **** 
