{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug STM32H533",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/microros_base.elf",
            
            "configFiles": [
                "interface/stlink-dap.cfg",
                "${workspaceFolder}/openocd_h5/stm32h5x.cfg"
            ],
            
            "device": "STM32H533RE",
            "downloadConfig": "always",
            
            "gdbPath": "/usr/bin/gdb-multiarch",
            "objdumpPath": "arm-none-eabi-objdump",
            "nmPath": "arm-none-eabi-nm",
            
            "runToEntryPoint": "main",

            "openOCDPreConfigLaunchCommands": [
                "set CONNECT_UNDER_RESET 0"
            ],

            "postLaunchCommands": [
                "monitor halt",
                "mem 0x08000000 0x08100000 ro",
                "set breakpoint auto-hw on",
                "set remote hardware-breakpoint-limit 8",
                "thbreak main",
                "continue"
            ]
        }
    ]
}